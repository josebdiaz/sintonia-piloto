    {
      "id": "97dc77e9-9ea9-4429-8819-ae33981a0199",
      "name": "Decidir acción",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        448
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const fila = $('Planes por recordar').item.json;\nlet r = $json || {};\nif (typeof r.data === 'string') {\n  try { r = JSON.parse(r.data); } catch (e) { r = { ok: false, error: 'respuesta_no_json' }; }\n}\nconst p = r.plan || r.data || r;\nconst estado = String(p.estado || '').toLowerCase();\nconst votos = Number(p.n_votos);\nconst invitados = Number(p.n_invitados);\nlet accion = 'error';\nlet codigo = '';\nif (r.ok !== true) { codigo = String(r.error || r.code || 'view_plan_fallido'); }\nelse if (estado === 'caido') { accion = 'caido'; }\nelse if (estado && estado !== 'votando') { accion = 'omitir'; }\nelse if (estado !== 'votando' || !Number.isFinite(votos) || !Number.isFinite(invitados)) { codigo = 'estado_desconocido'; }\nelse if (votos < invitados) { accion = 'recordar'; }\nelse { accion = 'todos_votaron'; }\nreturn { json: { accion, codigo, plan_id: fila.plan_id, grupo_wa: fila.grupo_wa || '', estado, n_votos: votos, n_invitados: invitados } };"
      }
    },
