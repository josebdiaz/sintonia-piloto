    {
      "id": "98718c6d-cdf6-49d8-97b0-17934bb5c576",
      "name": "Armar texto /opciones",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1552,
        128
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const n = $('Normalizar opciones').first().json;\nlet t = String($('Textos').first().json.plantilla_opciones || '');\nconst rep = (token, valor, falta) => { t = t.split(token).join(valor ? valor : falta); };\nrep('{n}', n.n_opciones ? String(n.n_opciones) : '', '[n]');\nrep('{opciones}', n.opciones_texto, '[opciones]');\nfor (let i = 1; i <= 3; i++) {\n  rep('{plan_' + i + '}', n['opcion_' + i + '_titulo'], '[plan ' + i + ']');\n  rep('{lugar_' + i + '}', n['opcion_' + i + '_lugar'], '[lugar ' + i + ']');\n  rep('{opcion_' + i + '}', n['opcion_' + i + '_titulo'] ? n['opcion_' + i + '_titulo'] + ': ' + n['opcion_' + i + '_lugar'] : '', '[opción ' + i + ']');\n}\nreturn [{ json: { texto: t } }];"
      }
    },
