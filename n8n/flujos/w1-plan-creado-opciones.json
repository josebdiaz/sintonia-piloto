    {
      "id": "ec0080dc-83a5-4214-85ca-6968e6c6a7ba",
      "name": "Normalizar opciones",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        224
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const r = $input.first().json || {};\nlet data = r;\nif (typeof r.data === 'string') {\n  try { data = JSON.parse(r.data); } catch (e) { data = { ok: false, error: 'respuesta_no_json' }; }\n}\nconst pick = (o) => {\n  if (!o) return [];\n  if (Array.isArray(o.opciones)) return o.opciones;\n  if (Array.isArray(o.options)) return o.options;\n  if (o.plan && Array.isArray(o.plan.opciones)) return o.plan.opciones;\n  if (o.data && Array.isArray(o.data.opciones)) return o.data.opciones;\n  return [];\n};\nconst lista = pick(data).slice(0, 3);\nconst out = { ok: data.ok === true, error: data.ok === true ? '' : String(data.error || data.code || 'error_desconocido'), n_opciones: lista.length };\nconst lineas = [];\nfor (let i = 0; i < 3; i++) {\n  const o = lista[i];\n  if (!o) { out['opcion_' + (i + 1) + '_titulo'] = ''; out['opcion_' + (i + 1) + '_lugar'] = ''; continue; }\n  const titulo = o.titulo || o.title || '[plan]';\n  const paradas = Array.isArray(o.paradas) ? o.paradas : Array.isArray(o.stops) ? o.stops : Array.isArray(o.lugares) ? o.lugares : [];\n  const lugar = paradas.map((p) => (p.nombre || p.name || '[lugar]') + ' (' + (p.zona || p.zone || '[zona]') + ')').join(' → ') || '[lugar]';\n  out['opcion_' + (i + 1) + '_titulo'] = titulo;\n  out['opcion_' + (i + 1) + '_lugar'] = lugar;\n  const nombres = paradas.map((p) => p.nombre || p.name || '[lugar]').join(' → ') || '[lugar]';\n  lineas.push((i + 1) + '\\uFE0F\\u20E3 ' + titulo + ' — ' + nombres + ' · salida ' + (o.hora_salida || '[hora de salida]') + ' · ' + (o.presupuesto_aprox || '[presupuesto]'));\n}\nout.opciones_texto = lineas.join('\\n');\nreturn [{ json: out }];"
      }
    },
