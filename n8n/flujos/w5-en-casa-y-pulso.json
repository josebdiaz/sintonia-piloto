      "id": "d05ba329-5f8a-4c9f-b13d-ed932c49b691",
      "name": "Ver plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        128
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const fila = $('Toca paso').item.json;\nlet r = $json || {};\nif (typeof r.data === 'string') {\n  try { r = JSON.parse(r.data); } catch (e) { r = { ok: false, error: 'respuesta_no_json' }; }\n}\nconst p = r.plan || r.data || r;\nconst estado = String(p.estado || '').toLowerCase();\nlet accion = fila.paso;\nlet codigo = '';\nif (r.ok !== true) { accion = 'error'; codigo = String(r.error || r.code || 'view_plan_fallido'); }\nelse if (estado === 'caido') { accion = 'caido'; }\nelse if (!estado) { accion = 'error'; codigo = 'estado_desconocido'; }\nreturn { json: { accion, codigo, plan_id: fila.plan_id, grupo_wa: fila.grupo_wa, estado } };"
      },
