      "id": "cee0a0a9-8306-4b2a-9504-6679f880afa9",
      "name": "Planes confirmados",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        496,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const ahora = DateTime.now().setZone('America/Bogota');\nconst salida = [];\nfor (const it of $input.all()) {\n  const f = it.json;\n  if (!f || !f.plan_id || !f.t_encuentro) continue;\n  const t = DateTime.fromISO(String(f.t_encuentro)).setZone('America/Bogota');\n  if (!t.isValid) continue;\n  let paso = '';\n  if (!f.en_casa_enviado) {\n    if (ahora >= t.plus({ hours: 3 })) paso = 'en_casa';\n  } else if (!f.retro_enviado) {\n    const retro = t.plus({ days: 1 }).set({ hour: 10, minute: 0, second: 0, millisecond: 0 });\n    if (ahora >= retro) paso = 'retro';\n  }\n  if (paso) salida.push({ json: { plan_id: f.plan_id, pid_organizador: f.pid_organizador || '', grupo_wa: f.grupo_wa || '', paso } });\n}\nreturn salida;"
      },
      "id": "ea6f62f4-abd7-4bd7-b62d-7d00f7c80b8a",
      "name": "Toca paso",
