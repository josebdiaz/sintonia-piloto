    {
      "parameters": {
        "jsCode": "// Interpreta el texto pegado desde el grupo. No guarda ni devuelve el texto original.\nconst f = Object.assign({}, $input.first().json, $('Mensaje del grupo').first().json);\nconst rawTexto = f.texto ?? f['Texto del mensaje'] ?? '';\nconst rawWa = f.wa ?? f['Número de WhatsApp de quien escribió (con +57)'] ?? '';\nconst rawGrupo = f.grupo_id ?? f['grupo_id'] ?? '';\nconst rawPlan = f.plan_id ?? f['plan_id'] ?? '';\nconst norm = String(rawTexto).toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^a-z0-9\\s]/g, ' ').replace(/\\s+/g, ' ').trim();\n\nconst SENSIBLE = /\\b(emergencia|urgente|accidente|hospital|ambulancia|policia|peligro|socorro|ayuda|enfermo|enferma|dolor|me siento mal|salud|ubicacion|donde estoy)\\b/;\nlet r;\nif (!norm) r = { accion: 'escalar', motivo: 'vacio' };\nelse if (SENSIBLE.test(norm)) r = { accion: 'escalar', motivo: 'sensible' };\nelse if (/^humano$/.test(norm)) r = { accion: 'escalar', motivo: 'pidio_humano' };\nelse {\n  let m;\n  if ((m = norm.match(/^(?:opcion |la |el |voto |voto por la |voy con la )?([123])$/))) r = { accion: 'voto', opcion: Number(m[1]) - 1, veto: false, etiqueta: 'opción ' + m[1] };\n  else if (/^todas$/.test(norm)) r = { accion: 'voto', opcion: -1, veto: false, etiqueta: 'TODAS' };\n  else if (/^ninguna$/.test(norm)) r = { accion: 'voto', opcion: -1, veto: true, etiqueta: 'NINGUNA (veto)' };\n  else if (/^me apunto$/.test(norm)) r = { accion: 'evento', tipo: 'me_apunto', etiqueta: 'ME APUNTO' };\n  else if (/^no puedo$/.test(norm)) r = { accion: 'evento', tipo: 'no_puedo', etiqueta: 'NO PUEDO' };\n  else if (/^llegue$/.test(norm)) r = { accion: 'evento', tipo: 'checkpoint_llegada', etiqueta: 'LLEGUÉ' };\n  else if (/^(ya en casa|llegue a casa)$/.test(norm)) r = { accion: 'evento', tipo: 'llego_casa', etiqueta: 'YA EN CASA' };\n  else if (/^salir$/.test(norm)) r = { accion: 'evento', tipo: 'salir', etiqueta: 'SALIR', aviso_equipo: true };\n  else r = { accion: 'escalar', motivo: 'no_entendido' };\n}\nreturn [{ json: { grupo_id: String(rawGrupo).trim(), plan_id: String(rawPlan).trim(), wa: String(rawWa).trim(), ...r } }];\n"
      },
