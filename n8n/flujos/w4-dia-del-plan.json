    {
      "id": "49ae4315-ecf3-4233-a619-220a41be359e",
      "name": "Decidir paso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        128
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const fila = $('En ventana de 3 h').item.json;\nlet r = $json || {};\nif (typeof r.data === 'string') {\n  try { r = JSON.parse(r.data); } catch (e) { r = { ok: false, error: 'respuesta_no_json' }; }\n}\nconst p = r.plan || r.data || r;\nconst estado = String(p.estado || '').toLowerCase();\nconst invitados = Number(p.n_invitados);\nconst llegaron = Number(p.n_llegaron !== undefined ? p.n_llegaron : p.llegaron);\nconst t = new Date(fila.t_encuentro).getTime();\nconst ahora = Date.now();\nlet accion = 'nada';\nlet codigo = '';\nif (r.ok !== true) { accion = 'error'; codigo = String(r.error || r.code || 'view_plan_fallido'); }\nelse if (estado === 'caido') { accion = 'caido'; }\nelse if (!fila.checkpoint_enviado) { accion = 'checkpoint'; }\nelse if (!Number.isFinite(invitados) || !Number.isFinite(llegaron) || invitados <= 0) { accion = fila.aviso_llegada_enviado ? 'nada' : 'error'; codigo = 'llegadas_desconocidas'; }\nelse if (llegaron >= invitados) { accion = 'llegaron'; }\nelse if (ahora >= t + 30 * 60 * 1000 && !fila.aviso_llegada_enviado) { accion = 'faltan'; }\nreturn { json: { accion, codigo, plan_id: fila.plan_id, grupo_wa: fila.grupo_wa || '', n_invitados: invitados, n_llegaron: llegaron } };"
      }
    },
