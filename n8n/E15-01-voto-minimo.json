    {
      "parameters": {
        "jsCode": "// Resume el resultado para quien revisa. No incluye texto original, nombres ni números.\nconst i = $('Interpretar texto').first().json;\nconst r = $input.first().json || {};\nconst ok = r.ok === true;\nconst errores = {\n  plan_no_votable: 'El plan no está en votación (¿ya se cerró o aún no se publica?).',\n  no_miembro: 'Esa persona no es miembro activo de este grupo.',\n  plan_no_existe: 'El plan_id no existe.',\n  tipo_invalido: 'Tipo de evento no válido en el backend.',\n  no_autorizado: 'El backend rechazó la clave del motor (revisa la credencial).'\n};\nlet titulo, mensaje;\nif (ok) {\n  titulo = 'Registrado: ' + i.etiqueta;\n  mensaje = 'Se envió al backend. Verifica en la consola que aparezca.';\n  if (i.aviso_equipo) mensaje += ' AVISA a una persona del equipo: el retiro con borrado de datos se hace desde la consola.';\n} else {\n  titulo = 'No se registró';\n  const e = r.error || (r.message ? 'error_de_red' : 'desconocido');\n  mensaje = (errores[e] || ('Error del backend: ' + e)) + ' Escala a una persona; no respondas solo.';\n}\nreturn [{ json: { titulo, mensaje } }];"
      },
